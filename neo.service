[Unit]
Description=Neo WhatsApp Assistant Bridge
After=network.target

[Service]
Type=simple
User=marcello
WorkingDirectory=/home/marcello/Documentos/www/Neo.JS
ExecStart=/home/marcello/Documentos/www/Neo.JS/start.sh
Restart=always
RestartSec=10
StandardOutput=append:/home/marcello/Documentos/www/Neo.JS/output.log
StandardError=append:/home/marcello/Documentos/www/Neo.JS/output.log
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
