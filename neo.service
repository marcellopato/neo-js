[Unit]
Description=Neo AI Assistant Backend (agent.py + bridge.js)
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=%u
WorkingDirectory=/path/to/Neo.JS
ExecStart=/path/to/Neo.JS/start.sh
ExecStop=/bin/bash -c 'kill $(cat /path/to/Neo.JS/backend.pid 2>/dev/null) 2>/dev/null; kill $(cat /path/to/Neo.JS/bridge.pid 2>/dev/null) 2>/dev/null; rm -f /path/to/Neo.JS/backend.pid /path/to/Neo.JS/bridge.pid'
Environment=NODE_ENV=production
Environment=HOME=%h

[Install]
WantedBy=multi-user.target
