GEMINI_API_KEY=sua_completa_api_key_aqui
INTERNAL_API_KEY=sua_senha_interna_segura
NEO_PASSWORD=sua_contra_senha
GROK_API_KEY=sua_opcional_api_key_xai_aqui

# Nota: GROK_API_KEY é usada como fallback apenas se a quota do Gemini principal esgotar.
# Ela é OPCIONAL — o Neo funciona normalmente só com GEMINI_API_KEY.

# Configurações de host (Opcionais, defaults já definidos)
# BRIDGE_HOST=bridge
# BACKEND_HOST=backend
