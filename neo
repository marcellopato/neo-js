#!/bin/bash
# Neo CLI launcher — usa o Python do venv do projeto automaticamente.
DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -x "$DIR/venv/bin/python" ]; then
    exec "$DIR/venv/bin/python" "$DIR/neo-cli.py" "$@"
else
    echo "[neo] ⚠️  venv não encontrado em $DIR/venv — rode: python3 -m venv venv && venv/bin/pip install -r requirements.txt"
    exit 1
fi
